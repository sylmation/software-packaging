<#
    {{PackageName}}
    Install script generated by the SCCMPackage module on {{GeneratedOn}}.

    Manufacturer : {{Manufacturer}}
    Product      : {{Product}}
    Version      : {{Version}}
#>
[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

$root = Split-Path -Parent $MyInvocation.MyCommand.Definition
$logDirectory = '{{LogPath}}'
if (-not (Test-Path -LiteralPath $logDirectory)) {
    New-Item -Path $logDirectory -ItemType Directory -Force | Out-Null
}
$logFile = Join-Path $logDirectory '{{Product}}-{{Version}}-Install.log'

function Write-InstallLog {
    param([string]$Message)
    $line = '{0} {1}' -f (Get-Date -Format 's'), $Message
    Add-Content -LiteralPath $logFile -Value $line
    Write-Output $line
}

$installer = Join-Path $root '{{InstallerFile}}'
if (-not (Test-Path -LiteralPath $installer)) {
    Write-InstallLog "Installer '$installer' was not found."
    exit 1
}

# %SourceRoot% lets a switch point at a response file shipped with the package,
# wherever the client happens to have cached the content.
$silentArguments = '{{SilentArguments}}'.Replace('%SourceRoot%', $root)

Write-InstallLog "Installing {{Product}} {{Version}} from '$installer'."

if ('{{InstallerType}}' -eq 'MSI') {
    $msiLog = Join-Path $logDirectory '{{Product}}-{{Version}}-Install.msi.log'
    $arguments = @('/i', "`"$installer`"", $silentArguments, '/l*v', "`"$msiLog`"") | Where-Object { $_ }
    $process = Start-Process -FilePath 'msiexec.exe' -ArgumentList $arguments -Wait -PassThru
}
else {
    if ($silentArguments) {
        $process = Start-Process -FilePath $installer -ArgumentList $silentArguments -Wait -PassThru
    }
    else {
        $process = Start-Process -FilePath $installer -Wait -PassThru
    }
}

Write-InstallLog "Install of {{Product}} {{Version}} finished with exit code $($process.ExitCode)."
exit $process.ExitCode
