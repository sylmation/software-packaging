<#
    {{PackageName}}
    Uninstall script generated by the SCCMPackage module on {{GeneratedOn}}.

    Manufacturer : {{Manufacturer}}
    Product      : {{Product}}
    Version      : {{Version}}
#>
[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

$logDirectory = '{{LogPath}}'
if (-not (Test-Path -LiteralPath $logDirectory)) {
    New-Item -Path $logDirectory -ItemType Directory -Force | Out-Null
}
$logFile = Join-Path $logDirectory '{{Product}}-{{Version}}-Uninstall.log'

function Write-UninstallLog {
    param([string]$Message)
    $line = '{0} {1}' -f (Get-Date -Format 's'), $Message
    Add-Content -LiteralPath $logFile -Value $line
    Write-Output $line
}

function Get-UninstallEntry {
    param([string]$DisplayName)

    $roots = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )

    Get-ItemProperty -Path $roots -ErrorAction SilentlyContinue |
        Where-Object { $_.DisplayName -like "*$DisplayName*" }
}

$productCode = '{{ProductCode}}'

if ($productCode) {
    $msiLog = Join-Path $logDirectory '{{Product}}-{{Version}}-Uninstall.msi.log'
    $arguments = @('/x', $productCode, '/qn', '/norestart', '/l*v', "`"$msiLog`"")
    Write-UninstallLog "Removing {{Product}} {{Version}} via msiexec $productCode."
    $process = Start-Process -FilePath 'msiexec.exe' -ArgumentList $arguments -Wait -PassThru
    $exitCode = $process.ExitCode
}
else {
    $entry = Get-UninstallEntry -DisplayName '{{Product}}' | Select-Object -First 1
    if (-not $entry) {
        Write-UninstallLog '{{Product}} is not installed, nothing to do.'
        exit 0
    }

    $command = $entry.QuietUninstallString
    if (-not $command) {
        $command = $entry.UninstallString
        if ($command -and '{{SilentUninstallArguments}}') {
            $command = '{0} {1}' -f $command, '{{SilentUninstallArguments}}'
        }
    }

    if (-not $command) {
        Write-UninstallLog "No uninstall command was found for {{Product}}."
        exit 1
    }

    Write-UninstallLog "Removing {{Product}} with: $command"
    $process = Start-Process -FilePath 'cmd.exe' -ArgumentList @('/c', "`"$command`"") -Wait -PassThru
    $exitCode = $process.ExitCode
}

Write-UninstallLog "Uninstall of {{Product}} {{Version}} finished with exit code $exitCode."
exit $exitCode
